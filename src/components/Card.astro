---
interface Props {
  type: 'book' | 'movie';
  item: {
    id: string;
    title: string;
    author?: string;
    director?: string;
    cover?: string;
    poster?: string;
    rating: number;
    genre: string[];
    year: number;
    description: string;
    article?: string | null;
  };
  baseUrl: string;
}

const { type, item, baseUrl } = Astro.props;
const image = type === 'book' ? item.cover : item.poster;
const creator = type === 'book' ? item.author : item.director;
const creatorLabel = type === 'book' ? '作者' : '导演';
const isRemoteImage = image && (image.startsWith('http://') || image.startsWith('https://'));
const imagePath = isRemoteImage ? image : `${baseUrl}/images/${type}s/${image}`;
const detailUrl = item.article ? `${baseUrl}${item.article}` : `${baseUrl}/${type}s/${item.id}`;
---

<a href={detailUrl} class="block">
  <div class="card group cursor-pointer">
    <div class="relative overflow-hidden">
      <img 
        src={imagePath} 
        alt={item.title}
        class="w-full h-64 object-cover transition-transform duration-500 group-hover:scale-110"
        loading="lazy"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300">
        <div class="absolute bottom-4 left-4 right-4">
          <div class="flex flex-wrap gap-1">
            {item.genre.slice(0, 3).map((g) => (
              <span class="bg-white/20 text-white text-xs px-2 py-1 rounded-full backdrop-blur-sm">
                {g}
              </span>
            ))}
          </div>
        </div>
      </div>
    </div>
    
    <div class="p-4">
      <h3 class="font-serif text-lg font-bold text-dark mb-2 group-hover:text-primary-500 transition-colors">
        {item.title}
      </h3>
      <p class="text-sm text-gray-500 mb-3">
        {item.year} · {item.genre.slice(0, 2).join(' / ')}
      </p>
      <p class="text-sm text-gray-600 line-clamp-3">
        {item.description}
      </p>
    </div>
  </div>
</a>