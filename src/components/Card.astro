---
interface Props {
  type: 'book' | 'movie';
  item: {
    id: string;
    title: string;
    author?: string;
    director?: string;
    cover?: string;
    poster?: string;
    rating: number;
    genre: string[];
    year: number;
    description: string;
    article?: string | null;
  };
  baseUrl: string;
}

const { type, item, baseUrl } = Astro.props;
const image = type === 'book' ? item.cover : item.poster;
const creator = type === 'book' ? item.author : item.director;
const creatorLabel = type === 'book' ? '作者' : '导演';
const isRemoteImage = image && (image.startsWith('http://') || image.startsWith('https://'));
const imagePath = isRemoteImage ? image : `${baseUrl}/images/${type}s/${image}`;
const detailUrl = item.article ? `${baseUrl}${item.article}` : `${baseUrl}/${type}s/${item.id}`;
---

<a href={detailUrl} class="block">
  <div class="card group cursor-pointer">
    <div class="relative overflow-hidden">
      <img 
        src={imagePath} 
        alt={item.title}
        class="w-full h-64 object-cover transition-transform duration-500 group-hover:scale-110"
        loading="lazy"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300">
        <div class="absolute bottom-4 left-4 right-4">
          <div class="flex flex-wrap gap-1">
            {item.genre.slice(0, 3).map((g) => (
              <span class="bg-white/20 text-white text-xs px-2 py-1 rounded-full backdrop-blur-sm">
                {g}
              </span>
            ))}
          </div>
        </div>
      </div>
    </div>
    
    <div class="p-4">
      <h3 class="font-serif text-lg font-bold text-dark mb-1 group-hover:text-primary-500 transition-colors">
        {item.title}
      </h3>
      <p class="text-sm text-gray-500 mb-2">
        {creatorLabel}：{creator} · {item.year}
      </p>
      <div class="flex items-center mb-3">
        {Array.from({ length: 5 }, (_, i) => (
          <svg
            class={`w-4 h-4 ${i < item.rating ? 'text-yellow-400' : 'text-gray-300'}`}
            fill="currentColor"
            viewBox="0 0 20 20"
          >
            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
          </svg>
        ))}
        <span class="text-sm text-gray-500 ml-2">{item.rating}/5</span>
      </div>
      <p class="text-sm text-gray-600 line-clamp-3">
        {item.description}
      </p>
    </div>
  </div>
</a>