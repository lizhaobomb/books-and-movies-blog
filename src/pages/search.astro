---
import Layout from '../layouts/Layout.astro';
import Card from '../components/Card.astro';

const allBooks = [
  {
    title: '百年孤独',
    author: '加西亚·马尔克斯',
    cover: '/images/books/百年孤独.jpg',
    rating: 5,
    genre: ['文学', '魔幻现实主义'],
    year: 1967,
    description: '《百年孤独》是魔幻现实主义文学的代表作，描写了布恩迪亚家族七代人的传奇故事，以及加勒比海沿岸小镇马孔多的百年兴衰，反映了拉丁美洲一个世纪以来风云变幻的历史。',
    featured: true,
  },
  {
    title: '小王子',
    author: '安托万·德·圣-埃克苏佩里',
    cover: '/images/books/小王子.jpg',
    rating: 5,
    genre: ['童话', '哲学'],
    year: 1943,
    description: '小王子是一个超凡脱俗的仙童，他住在一颗只比他大一丁点儿的小行星上。陪伴他的是一朵他非常喜爱的小玫瑰花。但玫瑰花的虚荣心伤害了小王子对她的感情。小王子告别小行星，开始了遨游太空的旅行。',
    featured: true,
  },
  {
    title: '活着',
    author: '余华',
    cover: '/images/books/活着.jpg',
    rating: 5,
    genre: ['文学', '现实主义'],
    year: 1993,
    description: '地主少爷福贵嗜赌成性，终于赌光了家业一贫如洗，穷困之中福贵因母亲生病前去求医，没想到半路上被国民党部队抓了壮丁，后被解放军所俘虏，回到家乡他才知道母亲已经过世，妻子家珍含辛茹苦带大了一双儿女，但女儿不幸变成了哑巴。',
    featured: true,
  },
];

const allMovies = [
  {
    title: '肖申克的救赎',
    director: '弗兰克·德拉邦特',
    poster: '/images/movies/肖申克的救赎.jpg',
    rating: 5,
    genre: ['剧情', '犯罪'],
    year: 1994,
    duration: 142,
    cast: ['蒂姆·罗宾斯', '摩根·弗里曼'],
    description: '一场谋杀案使银行家安迪蒙冤入狱，在鲨堡监狱里，他结识了黑人囚犯瑞德，两人成为朋友。安迪不动声色、步步为营地谋划自我拯救并最终成功越狱，同时也拯救了瑞德。',
    featured: true,
  },
  {
    title: '霸王别姬',
    director: '陈凯歌',
    poster: '/images/movies/霸王别姬.jpg',
    rating: 5,
    genre: ['剧情', '爱情', '历史'],
    year: 1993,
    duration: 171,
    cast: ['张国荣', '张丰毅', '巩俐'],
    description: '段小楼与程蝶衣是一对打小一起长大的师兄弟，两人一个演生，一个饰旦，一向配合天衣无缝，尤其一出《霸王别姬》，更是誉满京城。',
    featured: true,
  },
  {
    title: '千与千寻',
    director: '宫崎骏',
    poster: '/images/movies/千与千寻.jpg',
    rating: 5,
    genre: ['动画', '奇幻', '冒险'],
    year: 2001,
    duration: 125,
    cast: ['柊瑠美', '入野自由'],
    description: '千寻和爸爸妈妈一同驱车前往新家，在郊外的小路上不慎进入了神秘的隧道——Loss另一个世界。远处飘来食物的香味，爸爸妈妈大快朵颐，千寻却在附近的一栋建筑里找到了一份工作。',
    featured: true,
  },
];
---

<Layout title="搜索 - 书影分享">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- Search Header -->
    <div class="text-center mb-12">
      <h1 class="font-serif text-4xl font-bold text-dark mb-4">搜索</h1>
      <p class="text-gray-600 max-w-2xl mx-auto">
        搜索你感兴趣的书籍或电影。
      </p>
    </div>

    <!-- Search Box -->
    <div class="max-w-2xl mx-auto mb-12">
      <div class="relative">
        <input 
          type="text" 
          id="searchInput"
          placeholder="输入书名、作者、电影名、导演或标签..."
          class="w-full px-6 py-4 text-lg border border-gray-300 rounded-full focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-transparent"
        />
        <button 
          id="searchButton"
          class="absolute right-2 top-1/2 transform -translate-y-1/2 bg-primary-500 text-white p-3 rounded-full hover:bg-primary-600 transition-colors"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </button>
      </div>
    </div>

    <!-- Search Results -->
    <div id="searchResults" class="hidden">
      <h2 class="font-serif text-2xl font-bold text-dark mb-8 text-center">搜索结果</h2>
      <div id="resultsContainer" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        <!-- Results will be populated by JavaScript -->
      </div>
      <div id="noResults" class="hidden text-center py-12">
        <p class="text-gray-500 text-lg">未找到相关内容</p>
      </div>
    </div>

    <!-- Default Content -->
    <div id="defaultContent">
      <h2 class="font-serif text-2xl font-bold text-dark mb-8 text-center">热门推荐</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {allBooks.map((book) => (
          <Card type="book" item={book} />
        ))}
        {allMovies.map((movie) => (
          <Card type="movie" item={movie} />
        ))}
      </div>
    </div>
  </div>
</Layout>

<script>
  const searchInput = document.getElementById('searchInput');
  const searchButton = document.getElementById('searchButton');
  const searchResults = document.getElementById('searchResults');
  const resultsContainer = document.getElementById('resultsContainer');
  const noResults = document.getElementById('noResults');
  const defaultContent = document.getElementById('defaultContent');

  const allBooks = [
    {
      type: 'book',
      title: '百年孤独',
      author: '加西亚·马尔克斯',
      cover: '/images/books/百年孤独.jpg',
      rating: 5,
      genre: ['文学', '魔幻现实主义'],
      year: 1967,
      description: '《百年孤独》是魔幻现实主义文学的代表作，描写了布恩迪亚家族七代人的传奇故事，以及加勒比海沿岸小镇马孔多的百年兴衰，反映了拉丁美洲一个世纪以来风云变幻的历史。',
    },
    {
      type: 'book',
      title: '小王子',
      author: '安托万·德·圣-埃克苏佩里',
      cover: '/images/books/小王子.jpg',
      rating: 5,
      genre: ['童话', '哲学'],
      year: 1943,
      description: '小王子是一个超凡脱俗的仙童，他住在一颗只比他大一丁点儿的小行星上。陪伴他的是一朵他非常喜爱的小玫瑰花。但玫瑰花的虚荣心伤害了小王子对她的感情。小王子告别小行星，开始了遨游太空的旅行。',
    },
    {
      type: 'book',
      title: '活着',
      author: '余华',
      cover: '/images/books/活着.jpg',
      rating: 5,
      genre: ['文学', '现实主义'],
      year: 1993,
      description: '地主少爷福贵嗜赌成性，终于赌光了家业一贫如洗，穷困之中福贵因母亲生病前去求医，没想到半路上被国民党部队抓了壮丁，后被解放军所俘虏，回到家乡他才知道母亲已经过世，妻子家珍含辛茹苦带大了一双儿女，但女儿不幸变成了哑巴。',
    },
    {
      type: 'movie',
      title: '肖申克的救赎',
      director: '弗兰克·德拉邦特',
      poster: '/images/movies/肖申克的救赎.jpg',
      rating: 5,
      genre: ['剧情', '犯罪'],
      year: 1994,
      duration: 142,
      cast: ['蒂姆·罗宾斯', '摩根·弗里曼'],
      description: '一场谋杀案使银行家安迪蒙冤入狱，在鲨堡监狱里，他结识了黑人囚犯瑞德，两人成为朋友。安迪不动声色、步步为营地谋划自我拯救并最终成功越狱，同时也拯救了瑞德。',
    },
    {
      type: 'movie',
      title: '霸王别姬',
      director: '陈凯歌',
      poster: '/images/movies/霸王别姬.jpg',
      rating: 5,
      genre: ['剧情', '爱情', '历史'],
      year: 1993,
      duration: 171,
      cast: ['张国荣', '张丰毅', '巩俐'],
      description: '段小楼与程蝶衣是一对打小一起长大的师兄弟，两人一个演生，一个饰旦，一向配合天衣无缝，尤其一出《霸王别姬》，更是誉满京城。',
    },
    {
      type: 'movie',
      title: '千与千寻',
      director: '宫崎骏',
      poster: '/images/movies/千与千寻.jpg',
      rating: 5,
      genre: ['动画', '奇幻', '冒险'],
      year: 2001,
      duration: 125,
      cast: ['柊瑠美', '入野自由'],
      description: '千寻和爸爸妈妈一同驱车前往新家，在郊外的小路上不慎进入了神秘的隧道——Loss另一个世界。远处飘来食物的香味，爸爸妈妈大快朵颐，千寻却在附近的一栋建筑里找到了一份工作。',
    },
  ];

  function search(query) {
    const lowerQuery = query.toLowerCase();
    return allBooks.filter(item => {
      const searchableText = [
        item.title,
        item.author || item.director,
        ...item.genre,
        item.description,
      ].join(' ').toLowerCase();
      return searchableText.includes(lowerQuery);
    });
  }

  function renderResults(results) {
    if (results.length === 0) {
      resultsContainer.innerHTML = '';
      noResults.classList.remove('hidden');
      return;
    }

    noResults.classList.add('hidden');
    resultsContainer.innerHTML = results.map(item => {
      const image = item.type === 'book' ? item.cover : item.poster;
      const creator = item.type === 'book' ? item.author : item.director;
      const creatorLabel = item.type === 'book' ? '作者' : '导演';
      
      return `
        <div class="card group cursor-pointer">
          <div class="relative overflow-hidden">
            <img 
              src="${image}" 
              alt="${item.title}"
              class="w-full h-64 object-cover transition-transform duration-500 group-hover:scale-110"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300">
              <div class="absolute bottom-4 left-4 right-4">
                <div class="flex flex-wrap gap-1">
                  ${item.genre.slice(0, 3).map(g => `
                    <span class="bg-white/20 text-white text-xs px-2 py-1 rounded-full backdrop-blur-sm">
                      ${g}
                    </span>
                  `).join('')}
                </div>
              </div>
            </div>
          </div>
          
          <div class="p-4">
            <h3 class="font-serif text-lg font-bold text-dark mb-1 group-hover:text-primary-500 transition-colors">
              ${item.title}
            </h3>
            <p class="text-sm text-gray-500 mb-2">
              ${creatorLabel}：${creator} · ${item.year}
            </p>
            <div class="flex items-center mb-3">
              ${Array.from({ length: 5 }, (_, i) => `
                <svg
                  class="w-4 h-4 ${i < item.rating ? 'text-yellow-400' : 'text-gray-300'}"
                  fill="currentColor"
                  viewBox="0 0 20 20"
                >
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                </svg>
              `).join('')}
              <span class="text-sm text-gray-500 ml-2">${item.rating}/5</span>
            </div>
            <p class="text-sm text-gray-600 line-clamp-3">
              ${item.description}
            </p>
          </div>
        </div>
      `;
    }).join('');
  }

  function performSearch() {
    const query = searchInput.value.trim();
    if (query) {
      const results = search(query);
      searchResults.classList.remove('hidden');
      defaultContent.classList.add('hidden');
      renderResults(results);
    } else {
      searchResults.classList.add('hidden');
      defaultContent.classList.remove('hidden');
    }
  }

  searchButton.addEventListener('click', performSearch);
  searchInput.addEventListener('keypress', (e) => {
    if (e.key === 'Enter') {
      performSearch();
    }
  });
</script>