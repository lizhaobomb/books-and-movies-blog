---
import Layout from '../../layouts/Layout.astro';
import Card from '../../components/Card.astro';

const baseUrl = import.meta.env.BASE_URL || '/';

import books from '../../data/books.json';

const genres = [...new Set(books.flatMap(book => book.genre))];
---

<Layout title="书籍 - 书影分享">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- Page Header -->
    <div class="text-center mb-12">
      <h1 class="font-serif text-4xl font-bold text-dark mb-4">书籍推荐</h1>
      <p class="text-gray-600 max-w-2xl mx-auto">
        这些书籍陪伴我度过了许多美好时光，希望能与你分享其中的感动和思考。
      </p>
    </div>

    <!-- Filter Section -->
    <div class="mb-8">
      <div class="flex flex-wrap justify-center gap-2">
        <button class="px-4 py-2 rounded-full bg-primary-500 text-white text-sm font-medium transition-colors">
          全部
        </button>
        {genres.map((genre) => (
          <button class="px-4 py-2 rounded-full bg-white text-dark text-sm font-medium hover:bg-primary-50 transition-colors">
            {genre}
          </button>
        ))}
      </div>
    </div>

    <!-- Books Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {books.map((book) => (
        <Card type="book" item={book} baseUrl={baseUrl} />
      ))}
    </div>
  </div>
</Layout>