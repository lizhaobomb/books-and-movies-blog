---
import Layout from '../layouts/Layout.astro';
import Card from '../components/Card.astro';

const baseUrl = import.meta.env.BASE_URL || '/';

import books from '../data/books.json';
import movies from '../data/movies.json';

const featuredBooks = books.filter(book => book.featured);
const featuredMovies = movies.filter(movie => movie.featured);
---

<Layout title="首页 - 书影分享">
  <!-- Hero Section -->
  <section class="bg-gradient-to-r from-primary-500 to-primary-700 text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-24">
      <div class="text-center">
        <h1 class="font-serif text-4xl md:text-5xl lg:text-6xl font-bold mb-6 animate-fade-in">
          书影分享
        </h1>
        <p class="text-xl md:text-2xl text-primary-100 mb-8 animate-fade-in-delay">
          分享阅读和观影的乐趣，记录生活中的美好时光
        </p>
        <div class="flex justify-center space-x-4 animate-fade-in-delay-2">
          <a href={baseUrl + '/books'} class="btn-primary bg-white text-primary-500 hover:bg-gray-100">
            浏览书籍
          </a>
          <a href={baseUrl + '/movies'} class="btn-secondary border-white text-white hover:bg-white/10">
            探索电影
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Featured Books Section -->
  <section class="py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="font-serif text-3xl font-bold text-dark mb-4">精选书籍</h2>
        <p class="text-gray-600 max-w-2xl mx-auto">
          这些书籍陪伴我度过了许多美好时光，希望能与你分享其中的感动和思考。
        </p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {featuredBooks.map((book) => (
          <Card type="book" item={book} baseUrl={baseUrl} />
        ))}
      </div>
      <div class="text-center mt-10">
        <a href={baseUrl + '/books'} class="btn-primary">
          查看更多书籍
        </a>
      </div>
    </div>
  </section>

  <!-- Featured Movies Section -->
  <section class="py-16 bg-light">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="font-serif text-3xl font-bold text-dark mb-4">精选电影</h2>
        <p class="text-gray-600 max-w-2xl mx-auto">
          这些电影让我感动、思考、欢笑，希望能与你分享其中的精彩瞬间。
        </p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {featuredMovies.map((movie) => (
          <Card type="movie" item={movie} baseUrl={baseUrl} />
        ))}
      </div>
      <div class="text-center mt-10">
        <a href={baseUrl + '/movies'} class="btn-primary">
          查看更多电影
        </a>
      </div>
    </div>
  </section>

  <!-- Latest Posts Section -->
  <section class="py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="font-serif text-3xl font-bold text-dark mb-4">最新文章</h2>
        <p class="text-gray-600 max-w-2xl mx-auto">
          分享最新的阅读和观影心得
        </p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        <a href={baseUrl + '/posts/solo-mio-review'} class="card group hover:shadow-lg transition-shadow">
          <div class="p-6">
            <span class="inline-block bg-primary-100 text-primary-700 text-xs px-3 py-1 rounded-full mb-4">电影评论</span>
            <h3 class="font-serif text-xl font-bold text-dark mb-2 group-hover:text-primary-500 transition-colors">
              婚礼当天被逃婚，他独自去度了蜜月
            </h3>
            <p class="text-gray-600 text-sm line-clamp-2 mb-4">
              2026年最治愈的爱情片《我独自蜜月》，笑着笑着就哭了。首日票房322万美元，烂番茄观众评分96%...
            </p>
            <div class="flex items-center text-sm text-gray-500">
              <span>📅 2026年2月6日</span>
            </div>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- Categories Section -->
  <section class="py-16 bg-light">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="font-serif text-3xl font-bold text-dark mb-4">探索分类</h2>
        <p class="text-gray-600 max-w-2xl mx-auto">
          按类型浏览，发现你感兴趣的内容。
        </p>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        <a href={baseUrl + '/books?genre=文学'} class="card p-6 text-center hover:bg-primary-50 transition-colors">
          <div class="text-3xl mb-2">📚</div>
          <div class="font-serif font-bold">文学</div>
        </a>
        <a href={baseUrl + '/books?genre=科幻'} class="card p-6 text-center hover:bg-primary-50 transition-colors">
          <div class="text-3xl mb-2">🚀</div>
          <div class="font-serif font-bold">科幻</div>
        </a>
        <a href={baseUrl + '/movies?genre=剧情'} class="card p-6 text-center hover:bg-primary-50 transition-colors">
          <div class="text-3xl mb-2">🎬</div>
          <div class="font-serif font-bold">剧情</div>
        </a>
        <a href={baseUrl + '/movies?genre=动画'} class="card p-6 text-center hover:bg-primary-50 transition-colors">
          <div class="text-3xl mb-2">🎨</div>
          <div class="font-serif font-bold">动画</div>
        </a>
      </div>
    </div>
  </section>
</Layout>

<style>
  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-fade-in {
    animation: fadeIn 0.8s ease-out forwards;
  }

  .animate-fade-in-delay {
    animation: fadeIn 0.8s ease-out 0.2s forwards;
    opacity: 0;
  }

  .animate-fade-in-delay-2 {
    animation: fadeIn 0.8s ease-out 0.4s forwards;
    opacity: 0;
  }
</style>