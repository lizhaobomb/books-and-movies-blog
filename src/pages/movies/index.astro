---
import Layout from '../../layouts/Layout.astro';
import Card from '../../components/Card.astro';

const baseUrl = import.meta.env.BASE_URL || '/';

const movies = [
  {
    id: 'solo-mio',
    title: '我独自蜜月',
    director: '查尔斯·金南、丹尼尔·金南',
    poster: 'https://s41.ax1x.com/2026/06/04/pmV2fjx.webp',
    rating: 5,
    genre: ['剧情', '喜剧', '爱情'],
    year: 2026,
    duration: 118,
    cast: ['凯文·詹姆斯', '妮可·吉玛多'],
    description: '婚礼当天被逃婚，马特独自去度了蜜月，却意外收获了新的爱情。',
    featured: true,
    article: '/posts/solo-mio-review'
  },
  {
    id: 'legend-of-vox-machina-s4',
    title: '机械之声的传奇 第四季',
    director: 'Matthew Mercer',
    poster: 'https://s41.ax1x.com/2026/06/08/pmn91iT.jpg',
    rating: 5,
    genre: ['动画', '奇幻', '冒险'],
    year: 2026,
    duration: 45,
    cast: ['Laura Bailey', 'Travis Willingham'],
    description: '维克斯·玛奇纳小队回归，探讨英雄战后余生的故事，温情与热血并存。',
    featured: true,
    article: '/posts/legend-of-vox-machina-s4'
  }
];

const genres = [...new Set(movies.flatMap(movie => movie.genre))];
---

<Layout title="电影 - 书影分享">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="text-center mb-12">
      <h1 class="font-serif text-4xl font-bold text-dark mb-4">电影推荐</h1>
      <p class="text-gray-600 max-w-2xl mx-auto">
        这些电影让我感动、思考、欢笑，希望能与你分享其中的精彩瞬间。
      </p>
    </div>

    <div class="mb-8">
      <div class="flex flex-wrap justify-center gap-2">
        <button class="px-4 py-2 rounded-full bg-primary-500 text-white text-sm font-medium transition-colors">
          全部
        </button>
        {genres.map((genre) => (
          <button class="px-4 py-2 rounded-full bg-white text-dark text-sm font-medium hover:bg-primary-50 transition-colors">
            {genre}
          </button>
        ))}
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {movies.map((movie) => (
        <Card type="movie" item={movie} baseUrl={baseUrl} />
      ))}
    </div>
  </div>
</Layout>