---
import Layout from '../../layouts/Layout.astro';
import Card from '../../components/Card.astro';

const baseUrl = import.meta.env.BASE_URL || '/';

import movies from '../../data/movies.json';

const genres = [...new Set(movies.flatMap(movie => movie.genre))];
---

<Layout title="电影 - 书影分享">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- Page Header -->
    <div class="text-center mb-12">
      <h1 class="font-serif text-4xl font-bold text-dark mb-4">电影推荐</h1>
      <p class="text-gray-600 max-w-2xl mx-auto">
        这些电影让我感动、思考、欢笑，希望能与你分享其中的精彩瞬间。
      </p>
    </div>

    <!-- Filter Section -->
    <div class="mb-8">
      <div class="flex flex-wrap justify-center gap-2">
        <button class="px-4 py-2 rounded-full bg-primary-500 text-white text-sm font-medium transition-colors">
          全部
        </button>
        {genres.map((genre) => (
          <button class="px-4 py-2 rounded-full bg-white text-dark text-sm font-medium hover:bg-primary-50 transition-colors">
            {genre}
          </button>
        ))}
      </div>
    </div>

    <!-- Movies Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {movies.map((movie) => (
        <Card type="movie" item={movie} baseUrl={baseUrl} />
      ))}
    </div>

    <!-- Related Articles Section -->
    <div class="mt-16">
      <div class="text-center mb-8">
        <h2 class="font-serif text-2xl font-bold text-dark mb-4">📝 相关影评</h2>
      </div>
      <div class="bg-gradient-to-r from-primary-500 to-primary-700 rounded-lg p-6 text-white">
        <div class="flex flex-col md:flex-row items-center justify-between gap-6">
          <div class="flex-1">
            <span class="inline-block bg-white/20 text-white text-xs px-3 py-1 rounded-full mb-3">最新评论</span>
            <h3 class="font-serif text-xl font-bold mb-2">婚礼当天被逃婚，他独自去度了蜜月</h3>
            <p class="text-primary-100 text-sm mb-4">
              2026年最治愈的爱情片《我独自蜜月》，笑着笑着就哭了...
            </p>
          </div>
          <a href={baseUrl + '/posts/solo-mio-review'} class="px-6 py-3 bg-white text-primary-500 font-medium rounded-lg hover:bg-gray-100 transition-colors whitespace-nowrap">
            阅读全文
          </a>
        </div>
      </div>
    </div>
  </div>
</Layout>